# Kovexy as root, needed for the Incus module (phase 3). Prefer kovexy.service when Incus is not used.
[Unit]
Description=Kovexy reverse proxy (root)
After=network-online.target
Wants=network-online.target
# Never give up restarting, a reverse proxy that stays down takes every service with it
StartLimitIntervalSec=0

[Service]
StateDirectory=kovexy
WorkingDirectory=/var/lib/kovexy
# Sized for 2 to 4 cores and 4 to 8 GB, see docs/deployment.md "Memory" for small hosts
ExecStart=/usr/bin/java -Xmx1g -XX:+UseG1GC -XX:G1PeriodicGCInterval=60000 -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=30 -XX:+ExitOnOutOfMemoryError --enable-native-access=ALL-UNNAMED -jar /opt/kovexy/kovexy.jar dataDir=/var/lib/kovexy
Restart=on-failure
RestartSec=2s
# 78 is a rejected config or a port that cannot be bound, a restart does not fix either
RestartPreventExitStatus=78
SuccessExitStatus=143
UMask=0077
LimitCORE=0
LimitNOFILE=1048576
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
